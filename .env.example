# Modelo do .env do Cerebro Documental. Copie para `.env` e preencha.
# O `.env` real NUNCA vai para o Git (ver .gitignore).
# Este projeto so LE o SharePoint. Escrita e do projeto irmao de organizacao.

GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=

# Referencia (nao e credencial)
GRAPH_OBJECT_ID=
GRAPH_SECRET_ID=

# Alvo
SHAREPOINT_HOST=contoso.sharepoint.com
SHAREPOINT_SITE=/sites/exemplo
